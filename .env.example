# Macromatix credentials (same as live-dashboard-app)
SCRAPER_USERNAME=
SCRAPER_PASSWORD=
# Or encrypted:
# SCRAPER_CREDENTIALS_ENCRYPTED=
# SCRAPER_CREDENTIALS_KEY=

SCRAPER_HEADLESS=true
# SCRAPER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# SCRAPER_SLOW_MO_MS=100
# SCRAPER_DEVTOOLS=false

# Persisted Chrome profile (separate from dashboard scraper)
MMX_USER_DATA_DIR=./data/browser-profile
MMX_LOGIN_SUCCESS_URL_PART=MMS_Stores
# Key item count page (from npm run discover) — overrides pipeline.json gate.url
# MMX_GATE_URL=https://tacobellau.macromatix.net/REPLACE.aspx

# Local paths
MMX_WORK_DIR=./data
MMX_DOWNLOAD_DIR=./data/inbox
MMX_TEMPLATE_LOCAL="./data/workbooks/Build To JS.xlsx"

# Store checkbox in Supply Chain reports (tree on Report Selection page)
# Quote values that contain spaces when using bash "source" on this file.
MMX_STORE_NAME="3811 Chirnside Park"

# Hourly gate watch (npm run gate-watch): local hours 9–23
MMX_TIME_ZONE=Australia/Melbourne
MMX_GATE_SCHEDULE_START=9
MMX_GATE_SCHEDULE_END=23
# Scheduled orders: ms to wait after list date change (default 1200)
# MMX_POST_DATE_SETTLE_MS=1200
# MMX_SCHEDULED_TABLE_WAIT_MS=12000
# Optional: extra copy paths after merge (semicolon-separated, relative to repo root)
# MMX_TEMPLATE_SYNC=\\fileserver\share\Build To JS.xlsx

# Company server template (UNC) — optional; leave unset for local-only workflow
# MMX_TEMPLATE_SOURCE=\\fileserver\share\path\Build To JS.xlsx
# MMX_TEMPLATE_PUBLISH=\\fileserver\share\path\Build To JS.xlsx
MMX_TEMPLATE_ALWAYS_COPY=false

# Timeouts (ms)
MMX_NAV_TIMEOUT_MS=45000
MMX_DOWNLOAD_WAIT_MS=120000
MMX_LOGIN_WAIT_MS=300000
