[Unit]
Description=Macromatix full pipeline (gate, reports, Excel, orders)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=MMX_USER
WorkingDirectory=MMX_HOME/mmx-report-automation
EnvironmentFile=-MMX_HOME/mmx-report-automation/.env.production
EnvironmentFile=-MMX_HOME/mmx-report-automation/.env
ExecStartPre=/bin/bash MMX_HOME/mmx-report-automation/scripts/pi-git-pull.sh
ExecStart=/usr/bin/npm start
TimeoutStartSec=2400

[Install]
WantedBy=multi-user.target
