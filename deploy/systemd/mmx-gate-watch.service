[Unit]
Description=Macromatix key item gate watch (hourly, pauses after daily pipeline)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=MMX_USER
WorkingDirectory=MMX_HOME/mmx-report-automation
# Leading "-" = optional; at least one env file must exist on the Pi (see docs §3).
EnvironmentFile=-MMX_HOME/mmx-report-automation/.env.production
EnvironmentFile=-MMX_HOME/mmx-report-automation/.env
ExecStartPre=/bin/bash MMX_HOME/mmx-report-automation/scripts/pi-git-pull.sh
ExecStart=/usr/bin/npm run gate-watch
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
